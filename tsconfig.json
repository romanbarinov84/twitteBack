{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./",
    "outDir": "./dist",
    
    

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node","jest"]
  },
  "include": ["source/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}